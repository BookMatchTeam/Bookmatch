# Variaveis obrigatorias da API. A aplicacao valida todas durante o boot.
PORT=3000

# Aplicacao executada na maquina local
# DATABASE_URL e usada apenas pela CLI do Prisma (generate/migrate).
DATABASE_URL="mysql://bookmatch:bookmatch_dev@localhost:3306/bookmatch"
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=bookmatch
DATABASE_PASSWORD=bookmatch_dev
DATABASE_NAME=bookmatch

# Termos de uso e politica de privacidade: versao vigente, gravada no aceite.
TERMS_VERSION=1

# Origins aceitos pelo CORS e pela checagem de CSRF, separados por virgula.
# O localhost:3000 e o Swagger (/api/docs).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Chave do HMAC dos codigos de verificacao (pelo menos 32 caracteres).
# Gere com: openssl rand -hex 32
VERIFICATION_CODE_SECRET=troque-por-uma-chave-gerada-com-openssl-rand-hex-32

# Envio de e-mail por uma conta Gmail pessoal. Todas são obrigatórias.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=troque-pela-sua-conta@gmail.com
# Senha de app do Google; pode ser informada com ou sem espaços.
SMTP_PASSWORD=troque-pela-senha-de-app
EMAIL_FROM_NAME=BookMatch
# Precisa ser igual a SMTP_USER, sem diferenciar maiúsculas de minúsculas.
EMAIL_FROM_ADDRESS=troque-pela-sua-conta@gmail.com

# Banco local no Docker Compose
MARIADB_DATABASE=bookmatch
MARIADB_USER=bookmatch
MARIADB_PASSWORD=bookmatch_dev
MARIADB_ROOT_PASSWORD=bookmatch_root_dev
