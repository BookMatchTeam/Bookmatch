# Modelo do .env de producao do backend. Na VPS ele fica em ~/bookmatch/.env
# (veja backend/docs/deploy.md, fase 3). Esse arquivo nunca vai para o Git.
#
# Gere cada senha com:  openssl rand -hex 24
# (apenas letras e numeros: caracteres como @ ou / quebram a DATABASE_URL)
#
# O compose.prod.yaml transforma estes valores nas variaveis obrigatorias da
# API (PORT, DATABASE_* e as demais abaixo) e do servico de migrations
# (DATABASE_URL). A API valida sua configuracao completa antes de comecar a
# escutar requisicoes: se faltar alguma variavel, ela nao sobe.

# Banco de dados
MARIADB_DATABASE=bookmatch
MARIADB_USER=bookmatch
MARIADB_PASSWORD=troque-por-uma-senha-gerada
MARIADB_ROOT_PASSWORD=troque-por-outra-senha-gerada

# Versao vigente dos termos de uso e da politica de privacidade (ate 20
# caracteres). Ao publicar termos novos, troque o valor: o proximo cadastro
# grava o aceite da versao nova.
TERMS_VERSION=1

# Origins aceitos pelo CORS e pela checagem de CSRF, separados por virgula.
CORS_ORIGINS=https://bookmatch.galpao.tech

# Chave do HMAC dos codigos de verificacao (pelo menos 32 caracteres).
# Gere com:  openssl rand -hex 32
# Trocar a chave invalida os codigos ainda nao usados.
VERIFICATION_CODE_SECRET=troque-por-uma-chave-gerada

# Conta Gmail pessoal exclusiva da produção, autenticada com senha de app.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=troque-pela-conta-de-producao@gmail.com
SMTP_PASSWORD=troque-pela-senha-de-app
EMAIL_FROM_NAME=BookMatch
# Precisa ser igual a SMTP_USER, sem diferenciar maiúsculas de minúsculas.
EMAIL_FROM_ADDRESS=troque-pela-conta-de-producao@gmail.com
