# Caddy DENTRO do container do frontend: so serve os arquivos estaticos em HTTP.
# O HTTPS e o dominio ficam com o Caddy de borda da VPS (o do backend),
# que repassa bookmatch.galpao.tech para este container.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	# Arquivos em /assets tem hash no nome: podem ficar em cache "para sempre"
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# index.html e o resto: sempre revalidar, para o navegador pegar a versao nova
	@notAssets not path /assets/*
	header @notAssets Cache-Control "no-cache"

	# SPA: qualquer rota que nao seja arquivo cai no index.html (roteamento no React)
	try_files {path} /index.html
	file_server
}
